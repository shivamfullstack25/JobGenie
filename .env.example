# JobGenie configuration. Copy to .env (git-ignored) and fill in.
# Only INTERNAL_AUTH_SECRET is required; everything else has a working default or is optional.

# --- Required ---------------------------------------------------------------------------------
# Shared by every service to sign and verify who is calling. 32+ random characters. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_AUTH_SECRET=
# Firebase project used for sign-in. Must match the config in JobGenie-Frontend/src/firebase.ts
# (defaults to the project that file ships with).
FIREBASE_PROJECT_ID=jobgenie-d95c7

# enforce (default) | report-only (verify and log, block nothing) | off (no checks; local dev only)
AUTH_ENFORCEMENT=enforce
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---------------------------------------------------------------------------------
POSTGRES_USER=jobgenie_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobgenie_db
DATABASE_USERNAME=jobgenie_user
DATABASE_PASSWORD=change-me

# --- AI (all optional) ------------------------------------------------------------------------
# Tried in this order when LLM_PROVIDER=auto: Groq (free) -> Gemini (free tier) -> OpenAI (paid)
# -> Ollama. With none set, JobGenie runs on rules only and labels AI features accordingly.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# --- Job sources (optional) -------------------------------------------------------------------
# Adzuna licensed job API (free key: https://developer.adzuna.com/). Results must show "Adzuna".
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Public employer job boards to search: platform:token[:Company Name], comma-separated.
# Supported platforms: greenhouse, lever, ashby. Example: greenhouse:stripe,lever:netflix
JOB_BOARDS=

# --- Automation kill switches -----------------------------------------------------------------
# Safe defaults. JobGenie never submits applications; these gate scheduled background searches.
GLOBAL_AUTOMATION_ENABLED=false
DRY_RUN=true
DISABLED_PLATFORMS=

# --- Email for scheduled-search notifications (optional) --------------------------------------
SENDGRID_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# --- Optional: only needed to delete the Firebase login when a user deletes their account -----
# Place the service-account JSON in app/secrets/ (git-ignored).
FIREBASE_SERVICE_ACCOUNT_KEY=/app/secrets/firebase-service-account.json

LOG_LEVEL=INFO
